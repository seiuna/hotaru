# Copy to deploy/.env and replace every value marked CHANGE_ME.
# docker compose -f deploy/compose.yaml --env-file deploy/.env up -d --build

# --- Public identity -------------------------------------------------------
# Domain Caddy obtains a certificate for; must already point at this host.
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=ops@example.com
PUBLIC_BASE_URL=https://auth.example.com
JWT_AUDIENCE=hotaru-api
# Hostname for the admin console SPA (defaults to admin.$AUTH_DOMAIN when unset).
ADMIN_DOMAIN=admin.example.com
# Optional external account client used by password-reset links. There is no
# bundled user portal in this repository; leave blank for API-only use.
# PORTAL_BASE_URL=https://accounts.example.com
# Optional HTTP mail relay; receives {from,to,subject,text}. When unset, reset
# emails are printed to the auth-server log for local development.
# EMAIL_DELIVERY_URL=https://mail-relay.example.com/send
EMAIL_FROM=no-reply@example.com

# --- MongoDB ---------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=hotaru
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_mongo_password
MONGODB_DB=hotaru_auth
# Create declared indexes at boot (additive; never drops an existing index).
# Keep true: the unique constraints are correctness requirements.
MONGODB_ENSURE_INDEXES=true

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- Tokens & challenges ---------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CHALLENGE_TTL_SECONDS=60

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHALLENGE_MAX=10
RATE_LIMIT_VERIFY_MAX=10

# --- Mojang ----------------------------------------------------------------
MOJANG_SESSION_SERVER=https://sessionserver.mojang.com
MOJANG_HAS_JOINED_TIMEOUT_MS=5000
MOJANG_HAS_JOINED_ATTEMPTS=2
MOJANG_RETRY_DELAY_MS=500

# --- Authorization ---------------------------------------------------------
# Scopes every new player gets on first login. Keep it minimal (default deny).
DEFAULT_SCOPES=hotaru:profile
CORS_ORIGINS=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# --- Optional: bring your own keys (recommended for production) -------------
# When unset, the service generates a pair once and stores it in MongoDB.
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
# MINECRAFT_RSA_PRIVATE_KEY_PEM=
# MINECRAFT_RSA_PUBLIC_KEY_PEM=

# --- Activation codes ------------------------------------------------------
# Ed25519 public key used to verify signed account/bind activation codes.
# Generate a pair with `pnpm --filter @hotaru/auth-server activation:code -- --keygen`.
# Paste the public PEM here with newlines escaped as \n, or mount the file and
# set ACTIVATION_PUBLIC_KEY_FILE in a custom compose override.
# ACTIVATION_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# Optional: the auth server needs the private key only if admins issue codes
# from the console. Without it the console returns ACTIVATION_DISABLED and the
# CLI remains the only issuer.
# ACTIVATION_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ===========================================================================
# IRC server (SRP v1)
# ===========================================================================
# Every variable below maps 1:1 to apps/irc-server/src/config/env.ts. Values are
# passed into the container by deploy/compose.yaml; the ones whose names collide
# with the auth server (MONGODB_DB, CORS_ORIGINS) are aliased there, which is why
# they are called MONGODB_IRC_DB / IRC_CORS_ORIGINS here.

# --- Public identity -------------------------------------------------------
# Host Caddy obtains a certificate for and where clients open
# wss://<IRC_DOMAIN>/v1/connect. Point the DNS record at this host first.
IRC_DOMAIN=irc.example.com
# Unique id of this IRC node; presence records and pub/sub channels are keyed by
# it. When scaling out, give every replica its own value (irc-01, irc-02, ...).
INSTANCE_ID=irc-01

# --- Derived inside deploy/compose.yaml (not set here) ---------------------
# The IRC container also reads these app variables; compose derives them so the
# .env file cannot drift from the auth server's view of the same facts:
#   NODE_ENV     -> "production"
#   HOST, PORT   -> 0.0.0.0:3001 (never published; Caddy reaches it internally)
#   MONGODB_URI  -> mongodb://$MONGO_INITDB_ROOT_USERNAME:$MONGO_INITDB_ROOT_PASSWORD@mongo:27017/?authSource=admin
#   MONGODB_DB   -> $MONGODB_IRC_DB
#   REDIS_URL    -> redis://:$REDIS_PASSWORD@redis:6379
#   AUTH_JWKS_URL-> $AUTH_JWKS_URL (default below)
#   JWT_ISSUER   -> $PUBLIC_BASE_URL (the auth server's issuer; only tokens from
#                   that issuer are accepted, so it must not be overridden here)
#   JWT_AUDIENCE -> $JWT_AUDIENCE
#   ADMIN_UUIDS  -> $IRC_ADMIN_UUIDS
#   CORS_ORIGINS -> $IRC_CORS_ORIGINS

# --- Storage ---------------------------------------------------------------
# IRC collections (players mirror, groups, filters, audit) live in their own DB
# on the same MongoDB instance as the auth server.
MONGODB_IRC_DB=hotaru_irc
# Create the IRC collections' indexes at boot (additive; never drops an index).
# Keep true: the unique constraints and the 30-day audit TTL depend on it.
MONGODB_IRC_ENSURE_INDEXES=true

# --- Token verification ----------------------------------------------------
# JWKS is fetched over the internal Docker network, not through Caddy.
AUTH_JWKS_URL=http://auth-server:3000/api/v1/auth/jwks
# How long a fetched JWKS is trusted before it is re-fetched (ms).
JWKS_CACHE_TTL_MS=600000
# JWT_ISSUER is not duplicated here: compose passes PUBLIC_BASE_URL (the auth
# server's issuer) to the IRC service, because only tokens issued by THAT
# issuer are accepted.

# --- Connection limits and liveness ----------------------------------------
# Ping every heartbeatIntervalMs; drop the socket when no pong arrives within
# pongTimeoutMs (a dead TCP connection is otherwise invisible).
HEARTBEAT_INTERVAL_MS=30000
PONG_TIMEOUT_MS=15000
# Redis presence record TTL; the safety net for a crashed node's ghost sessions.
PRESENCE_TTL_MS=90000
# Per-account / per-IP / total concurrent WebSocket budgets for ONE node.
MAX_CONNECTIONS_PER_USER=3
MAX_CONNECTIONS_PER_IP=20
MAX_CONNECTIONS_TOTAL=10000

# --- Message limits --------------------------------------------------------
# Token bucket per connection: sustained rate and burst allowance.
MESSAGE_RATE_PER_SEC=20
MESSAGE_BURST=40
# Groups are stricter: a group fan-out costs one token per recipient.
GROUP_MESSAGE_RATE_PER_SEC=10
# Groups a single player may create per hour.
CREATE_GROUP_PER_HOUR=5
# Payload budget (business payload) and whole-frame budget, in bytes.
MAX_PAYLOAD_BYTES=65536
MAX_FRAME_BYTES=131072
# Members per group.
MAX_GROUP_MEMBERS=100
# A socket whose send buffer exceeds this is closed as a slow client (code 1013).
MAX_WS_BUFFERED_BYTES=1048576
# How long a (sender, message id) pair is remembered for replay suppression.
DEDUPE_TTL_MS=120000

# --- Authorization ---------------------------------------------------------
# Comma-separated Mojang UUIDs that may edit global filter rules and broadcast.
# Keep this empty and use the hotaru:irc:broadcast scope instead where you can.
IRC_ADMIN_UUIDS=
# Set to false to disable BROADCAST routing entirely, whatever the scopes say.
BROADCAST_ENABLED=true
# Browser origins allowed to call the IRC REST API. Empty = no CORS grant, which
# is the right default for a server-to-server / mod-client deployment.
IRC_CORS_ORIGINS=
