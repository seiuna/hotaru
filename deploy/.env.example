# Copy to deploy/.env and replace every value marked CHANGE_ME.
# docker compose -f deploy/compose.yaml --env-file deploy/.env up -d --build

# --- Public identity -------------------------------------------------------
# Domain Caddy obtains a certificate for; must already point at this host.
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=ops@example.com
PUBLIC_BASE_URL=https://auth.example.com
JWT_AUDIENCE=skymatrix-api

# --- MongoDB ---------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=skymatrix
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_mongo_password
MONGODB_DB=skymatrix_auth
# Create declared indexes at boot (additive; never drops an existing index).
# Keep true: the unique constraints are correctness requirements.
MONGODB_ENSURE_INDEXES=true

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- Tokens & challenges ---------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CHALLENGE_TTL_SECONDS=60

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHALLENGE_MAX=10
RATE_LIMIT_VERIFY_MAX=10

# --- Mojang ----------------------------------------------------------------
MOJANG_SESSION_SERVER=https://sessionserver.mojang.com
MOJANG_HAS_JOINED_TIMEOUT_MS=5000
MOJANG_HAS_JOINED_ATTEMPTS=2
MOJANG_RETRY_DELAY_MS=500

# --- Authorization ---------------------------------------------------------
# Scopes every new player gets on first login. Keep it minimal (default deny).
DEFAULT_SCOPES=skymatrix:profile
CORS_ORIGINS=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# --- Optional: bring your own keys (recommended for production) -------------
# When unset, the service generates a pair once and stores it in MongoDB.
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
# MINECRAFT_RSA_PRIVATE_KEY_PEM=
# MINECRAFT_RSA_PUBLIC_KEY_PEM=
