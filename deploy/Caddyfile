# Caddy terminates TLS (automatic Let's Encrypt certificate) and proxies to the
# auth server on the internal Docker network. The auth server itself never
# listens on the public interface in this stack.

{
	email {$ACME_EMAIL}
	# Keep upstream failures short: a hanging Mojang call must not pin a client.
	# NOTE: Caddy's server timeout option names are read_body / read_header /
	# write / idle — not read_timeout / write_timeout.
	servers {
		timeouts {
			read_body 10s
			read_header 10s
			write 30s
			idle 120s
		}
	}
}

{$AUTH_DOMAIN} {
	encode zstd gzip

	# Authentication payloads are tiny (a few KB). Refuse anything larger early.
	request_body {
		max_size 64KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Never log Authorization / Cookie headers or query strings that could carry
	# tokens. Only method, path, status and latency are recorded.
	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
		format json
		level INFO
	}

	reverse_proxy auth-server:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		# Mojang hasJoined is slow by nature; allow the app's own timeout to fire
		# before Caddy gives up.
		transport http {
			dial_timeout 5s
			response_header_timeout 15s
		}
	}

	# Health endpoints are public but must never be cached.
	@health path /api/v1/health/*
	header @health Cache-Control "no-store"

	# Drop the docs UI from the public deployment unless explicitly wanted.
	@docs path /docs /docs/*
	respond @docs 404
}

# ---------------------------------------------------------------------------
# Admin console. Same-origin by design: the SPA calls /api on this host, so it
# needs no CORS grant and no absolute API origin baked into the bundle.
# ---------------------------------------------------------------------------
{$ADMIN_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# API calls from the console go to the auth server, never directly to Mongo/Redis.
	handle /api/* {
		reverse_proxy auth-server:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Everything else is the static SPA.
	handle {
		reverse_proxy admin-web:80
	}

	log {
		output file /data/admin-access.log {
			roll_size 10MB
			roll_keep 5
		}
		format json
		level INFO
	}
}

# ---------------------------------------------------------------------------
# End-user portal. Same-origin: the SPA calls /api on this host, while account
# and binding routes live on the auth server.
# ---------------------------------------------------------------------------
{$USER_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /api/* {
		reverse_proxy auth-server:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy user-portal:80
	}

	log {
		output file /data/user-access.log {
			roll_size 10MB
			roll_keep 5
		}
		format json
		level INFO
	}
}

# ---------------------------------------------------------------------------
# IRC / SRP v1 edge.
#
# One public host carries two very different transports:
#
#   wss://<IRC_DOMAIN>/v1/connect   long-lived WebSocket (hours), authenticated
#                                  by an `Authorization: Bearer <JWT>` header on
#                                  the upgrade request
#   https://<IRC_DOMAIN>/v1/*       small JSON REST calls (groups, filters,
#                                   presence) and the health probes
#
# The upstream (irc-server:3001) is not published on the host; this block is the
# only way in.
# ---------------------------------------------------------------------------
{$IRC_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# --- 1. WebSocket upgrade -------------------------------------------------
	# `reverse_proxy` inspects `Connection: Upgrade` / `Upgrade: websocket` and
	# switches to a raw bidirectional tunnel on its own; no `websocket` option is
	# needed (and Caddy v2 has none). What it DOES need is permission to stay
	# quiet: the timeouts below are the edge's half of SRP's liveness contract —
	# the IRC server pings every 30s and terminates a silent peer, so Caddy must
	# never be the reason a healthy idle session dies.
	@connect path /v1/connect
	# A hijacked (upgraded) connection is exempt from the global server
	# read/write/idle timeouts below, but the upstream transport deadlines still
	# apply to the tunnel, which is why they are raised here.
	handle @connect {
		reverse_proxy irc-server:3001 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				dial_timeout 5s
				# The upgrade response is immediate (READY is sent right after).
				response_header_timeout 10s
				read_timeout 1h
				write_timeout 1h
			}
		}
	}

	# --- 2. REST + health -----------------------------------------------------
	handle /v1/* {
		encode zstd gzip
		# Mirrors the server's own 128 KB body limit; refuse oversized bodies at
		# the edge instead of buffering them.
		request_body {
			max_size 128KB
		}
		reverse_proxy irc-server:3001 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				dial_timeout 5s
				response_header_timeout 15s
			}
		}
	}

	handle /health/* {
		header Cache-Control "no-store"
		reverse_proxy irc-server:3001 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		respond 404
	}

	# Never log bearer tokens. Caddy's JSON access log redacts `Authorization` and
	# `Cookie` values to "REDACTED" by default (verified against caddy:2-alpine);
	# field-level `exclude` is only available on the global `log` option, not on a
	# site `log` directive, so the default redaction is the mechanism here.
	# Query strings ARE recorded, which is why SRP never accepts a token in the
	# URL: the only query parameters in this API are non-secret list filters.
	log {
		output file /data/irc-access.log {
			roll_size 10MB
			roll_keep 5
		}
		format json
		level INFO
	}
}
