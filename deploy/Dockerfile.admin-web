# syntax=docker/dockerfile:1
# Static build of the admin console, served by nginx with SPA fallback.

FROM node:24-alpine AS build
ENV CI=true
RUN corepack enable && corepack prepare pnpm@11.12.0 --activate
WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/api-contract/package.json packages/api-contract/
COPY apps/admin-web/package.json apps/admin-web/
RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/admin-web ./apps/admin-web

# The SPA imports workspace types from the built contract packages.
RUN pnpm --filter @skymatrix/shared-types build \
 && pnpm --filter @skymatrix/api-contract build \
 && pnpm --filter @skymatrix/admin-web build

FROM nginx:1.27-alpine AS runtime
COPY deploy/nginx.admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/admin-web/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
