{
  "name": "hotaru-servers",
  "version": "0.2.1",
  "private": true,
  "description": "Hotaru servers monorepo — MC Auth Platform (Minecraft premium authentication & authorization)",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @hotaru/auth-server dev",
    "start": "pnpm --filter @hotaru/auth-server start",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @hotaru/auth-server test:integration",
    "lint": "pnpm -r --if-present lint",
    "clean": "pnpm -r --if-present clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f deploy/compose.yaml --env-file deploy/.env up -d mongo redis",
    "infra:down": "docker compose -f deploy/compose.yaml --env-file deploy/.env down",
    "setup": "node tools/setup/setup.mjs",
    "test:setup": "node --test tools/setup/setup.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
