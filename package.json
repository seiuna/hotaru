{
  "name": "skymatrix-servers",
  "version": "0.0.0",
  "private": true,
  "description": "Skymatrix servers monorepo",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @skymatrix/api dev",
    "start": "pnpm --filter @skymatrix/api start",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "pnpm -r --if-present clean",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0"
  }
}
