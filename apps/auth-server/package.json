{
  "name": "@hotaru/auth-server",
  "version": "0.3.0-beta.1",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run -c vitest.config.ts",
    "test:watch": "vitest -c vitest.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "lint": "eslint src tests",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "activation:code": "tsx scripts/activation-code.ts",
    "migrate:accounts": "tsx scripts/migrate-accounts.ts",
    "seed:player": "tsx scripts/seed-player.ts",
    "admin:seed": "tsx scripts/seed-admin.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@hotaru/api-contract": "workspace:*",
    "@hotaru/shared-types": "workspace:*",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "mongoose": "^8.8.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
