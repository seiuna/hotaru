# Real-Minecraft-credential login test — copy next to this file as `.env.real`,
# or put these three lines in apps/auth-server/.env (both are git-ignored).
#
# ONLY for accounts you own. The token grants full access to the account:
# treat it like a password, never commit it, and rotate it by logging the
# account out of the launcher when you are done testing.

# The Minecraft session token your launcher holds (NOT a Microsoft password).
MC_ACCESS_TOKEN=

# The account UUID, dashed or undashed, e.g. 069a79f444e94726a5befca90e38aaf5
MC_UUID=

# The current Minecraft username, e.g. Notch
MC_USERNAME=
