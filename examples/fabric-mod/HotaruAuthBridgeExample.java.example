// Example (NOT compiled): wiring LocalAuthBridge into a Fabric client mod.
// Minecraft/Fabric classes are not on the standalone classpath, so this file lives as documentation.
// Copy it into your mod's source set, adjust the package, and add the Fabric API dependency.

package com.example.hotaru.client;

import cn.seiua.mcauth.McAuthClient;
import cn.seiua.mcauth.SessionProvider;
import cn.seiua.mcauth.TokenResponse;
import cn.seiua.mcauth.bridge.ApprovalGate;
import cn.seiua.mcauth.bridge.BridgeConfig;
import cn.seiua.mcauth.bridge.LocalAuthBridge;
import net.fabricmc.api.ClientModInitializer;
import net.fabricmc.api.EnvType;
import net.fabricmc.api.Environment;
import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientLifecycleEvents;
import net.minecraft.client.MinecraftClient;

import java.time.Duration;

/**
 * Starts the loopback bridge when the game starts and stops it on shutdown.
 *
 * <p>Two things matter for security:
 * <ul>
 *   <li>{@code allowedOrigins} is an exact allowlist — never a wildcard. Put your production console
 *       origin here; add {@code http://localhost:5173} only for local development.</li>
 *   <li>{@code ApprovalGate} must ask the player. This example opens a confirmation screen; it never
 *       returns {@code true} on its own.</li>
 * </ul>
 */
@Environment(EnvType.CLIENT)
public final class HotaruAuthBridge implements ClientModInitializer {

    /** Production console + the Vite dev origin. Trim this for a release build. */
    private static final String[] ALLOWED_ORIGINS = {
        "https://admin.example.com",
        "http://localhost:5173",
    };

    private static final McAuthClient AUTH = McAuthClient.builder("https://auth.example.com").build();

    private LocalAuthBridge bridge;

    @Override
    public void onInitializeClient() {
        MinecraftClient client = MinecraftClient.getInstance();

        // The game session, read lazily: the player may re-login while the bridge is up.
        SessionProvider session = new SessionProvider() {
            @Override
            public String accessToken() {
                return MinecraftClient.getInstance().getSession().getAccessToken();
            }

            @Override
            public String playerUuid() {
                return MinecraftClient.getInstance().getSession().getUuid();
            }

            @Override
            public String username() {
                return MinecraftClient.getInstance().getSession().getUsername();
            }
        };

        try {
            BridgeConfig config = new BridgeConfig(
                BridgeConfig.LOOPBACK,          // never 0.0.0.0
                8765,                           // must match the console's DEFAULT_BRIDGE_PORT
                java.util.Set.of(ALLOWED_ORIGINS),
                Duration.ofSeconds(60),         // how long the player may take to confirm
                5,                              // login attempts per origin per minute
                true);                          // emit Access-Control-Allow-Private-Network

            bridge = LocalAuthBridge.start(
                config,
                () -> AUTH.authenticate(session),
                new ScreenApprovalGate(client),   // asks the player; see below
                message -> HotaruClient.LOGGER.info("[auth-bridge] {}", message));
        } catch (Exception failure) {
            // A busy port must not crash the game: log it and let the player use the paste-token flow.
            HotaruClient.LOGGER.warn("[auth-bridge] could not start", failure);
        }

        ClientLifecycleEvents.CLIENT_STOPPING.register(ignored -> {
            if (bridge != null) bridge.close();
        });
    }

    /**
     * Shows "允许 <origin> 登录 Hotaru？" on the client thread and blocks the HTTP worker until the
     * player answers. Returning {@code false} on timeout is the safe default.
     */
    private static final class ScreenApprovalGate implements ApprovalGate {
        private final MinecraftClient client;

        ScreenApprovalGate(MinecraftClient client) {
            this.client = client;
        }

        @Override
        public boolean approve(String origin, Duration timeout) {
            // Real implementation: client.execute(() -> client.setScreen(new ApproveLoginScreen(origin, result)))
            // where ApproveLoginScreen completes a CompletableFuture<Boolean>; then:
            //   return future.get(timeout.toMillis(), TimeUnit.MILLISECONDS);
            // never `return true` without asking.
            return false; // placeholder: deny until the screen is implemented
        }
    }
}
