// Example (NOT compiled): wiring the Skymatrix IRC SDK into a Fabric client mod.
// Minecraft/Fabric classes are not on the standalone classpath, so this file lives as documentation.
// Copy it into your mod's client source set, adjust the package, and add the Fabric API dependency.

package com.example.skymatrix.client;

import com.skymatrix.irc.IrcClient;
import com.skymatrix.irc.ReconnectPolicy;
import net.fabricmc.api.ClientModInitializer;
import net.fabricmc.api.EnvType;
import net.fabricmc.api.Environment;
import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientLifecycleEvents;
import net.minecraft.client.MinecraftClient;

import java.time.Duration;

/**
 * Starts the relay connection when the player joins a world and closes it on
 * shutdown. The two integration points are the token (from the auth library) and
 * the executor (the game thread).
 */
@Environment(EnvType.CLIENT)
public final class FabricIrcExample implements ClientModInitializer {

    private IrcClient irc;

    @Override
    public void onInitializeClient() {
        MinecraftClient client = MinecraftClient.getInstance();

        irc = IrcClient.builder("wss://irc.example.com")
                // The MC Auth Java client owns the handshake; this SDK only needs the JWT.
                .tokenProvider(() -> SkymatrixAuth.currentAccessToken())
                // Every callback runs on the client thread: safe to touch HUD/world state.
                .dispatchExecutor(client::execute)
                .reconnectPolicy(ReconnectPolicy.defaults())
                .ackTimeout(Duration.ofSeconds(10))
                .logger(message -> SkymatrixClient.LOGGER.debug(message))
                .build();

        irc.on("chat.message", message -> {
            // message.senderUuid() is server-attested; message.payload() is JSON.
            SkymatrixClient.LOGGER.info("[irc] {}: {}", message.senderUuid(), message.text());
        });
        irc.on("skymatrix.*", message -> SkymatrixClient.MOD.handle(message.type(), message.payload()));
        irc.onAck(ack -> {
            if (ack.isFailed()) {
                SkymatrixClient.LOGGER.debug("send {} failed: {}", ack.replyTo(), ack.reason());
            }
        });
        irc.onError(error -> SkymatrixClient.LOGGER.warn("irc protocol error {}", error));
        irc.onStateChange(state -> SkymatrixClient.LOGGER.info("irc state {}", state));

        // Connect off the render thread; the future resolves with the server's READY.
        irc.connect().whenComplete((ready, failure) -> {
            if (failure != null) {
                SkymatrixClient.LOGGER.warn("irc connect failed", failure);
            }
        });

        ClientLifecycleEvents.CLIENT_STOPPING.register(ignored -> {
            if (irc != null) irc.close();
        });
    }

    /** Example: send a party state update through the relay. */
    public static void broadcastPartyState(String groupId, String phase) {
        if (irc == null || !irc.isConnected()) return;
        irc.sendGroupAsync(groupId, "skymatrix.party.state", java.util.Map.of("phase", phase));
    }
}
